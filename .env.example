# ==============================================================================
# The Digital Toolkit - Content Automation Engine Environment Configuration
# Publication: The Digital Toolkit (https://digitaltoolkitguide.blogspot.com/)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI Studio & Gemini API
# ------------------------------------------------------------------------------
# GEMINI_API_KEY: Required for Gemini AI API article generation.
# AI Studio automatically injects this at runtime from user secrets.
# In GitHub Actions, configure this as a repository secret: GEMINI_API_KEY
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# Injected at runtime by AI Studio.
APP_URL="MY_APP_URL"

# ------------------------------------------------------------------------------
# 2. Google Blogger API v3 Credentials
# ------------------------------------------------------------------------------
# BLOGGER_BLOG_ID: The unique numeric ID of your blog on Blogger.
# Found in your Blogger dashboard URL (e.g., https://www.blogger.com/blog/posts/YOUR_BLOG_ID)
BLOGGER_BLOG_ID="YOUR_BLOG_ID_HERE"

# BLOGGER_CLIENT_ID: OAuth 2.0 Client ID created in Google Cloud Console
# Application type must be "Desktop application".
BLOGGER_CLIENT_ID="YOUR_OAUTH_CLIENT_ID.apps.googleusercontent.com"

# BLOGGER_CLIENT_SECRET: OAuth 2.0 Client Secret from Google Cloud Console.
BLOGGER_CLIENT_SECRET="YOUR_OAUTH_CLIENT_SECRET"

# BLOGGER_REFRESH_TOKEN: Long-lived OAuth2 refresh token generated via scripts/get_blogger_refresh_token.py.
# Never commit this token to source control or print it in CI logs.
BLOGGER_REFRESH_TOKEN="YOUR_OAUTH_REFRESH_TOKEN"

# ------------------------------------------------------------------------------
# 3. Cloudflare Worker & D1 Database Backend
# ------------------------------------------------------------------------------
# CLOUDFLARE_WORKER_URL: Supporting Worker URL (e.g. https://digital-toolkit-worker.yourname.workers.dev)
CLOUDFLARE_WORKER_URL="https://digital-toolkit-worker.example.workers.dev"

# CLOUDFLARE_WORKER_SECRET: Shared Bearer authentication secret configured on the Worker
CLOUDFLARE_WORKER_SECRET="YOUR_WORKER_API_SECRET"

# ------------------------------------------------------------------------------
# 4. Pipeline Execution Controls
# ------------------------------------------------------------------------------
# DRY_RUN: Set to 'true' to run end-to-end simulation without modifying Blogger or D1.
# Defaults to 'true' for safety.
DRY_RUN="true"

# PUBLISH_MODE: Set to 'draft' (default) to create draft posts for editorial review.
# Only set to 'publish' when live publishing is explicitly verified.
PUBLISH_MODE="draft"

# CONFIRM_LIVE_PUBLISH: Must be set to 'true' if PUBLISH_MODE is 'publish'.
# Prevents accidental direct publication.
CONFIRM_LIVE_PUBLISH="false"

# ZAMBIA_CONTEXT_ENABLED: Set to 'false' (default) for general international audience.
# Set to 'true' to include Zambia-specific mobile money and bank details when relevant.
ZAMBIA_CONTEXT_ENABLED="false"

# MAX_ARTICLES_PER_RUN: Max articles to process in a single execution (default 1).
MAX_ARTICLES_PER_RUN="1"
